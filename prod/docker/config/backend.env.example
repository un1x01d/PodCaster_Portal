NODE_ENV=production
PORT=4000

# Database (host Postgres, not containerized)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=tforn_insights_db
POSTGRES_USER=tforn_insights
POSTGRES_PASSWORD=CHANGE_ME

# Security
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
ALLOW_EPHEMERAL_JWT_SECRET=false

# AI providers (set only what you use)
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Upload/runtime limits
MAX_UPLOAD_FILE_MB=64
OPENAI_TIMEOUT_MS=60000

# Keep this enabled for durable import queue
IMPORT_DB_QUEUE_ENABLED=true
