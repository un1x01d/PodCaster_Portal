# Database Configuration
POSTGRES_USER=portal
POSTGRES_PASSWORD=choose_a_strong_password
POSTGRES_DB=portaldb

# Backend Configuration
DATABASE_URL=postgres://portal:choose_a_strong_password@db:5432/portaldb
JWT_SECRET=generate_a_long_random_string_at_least_32_characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=data-insights-portal
JWT_AUDIENCE=data-insights-portal-api
ALLOW_LEGACY_PLAINTEXT_PASSWORDS=false
SETTINGS_CRYPTO_KEY=generate_a_unique_random_key_for_setting_encryption_32_chars_min
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=25000
OPENAI_INPUT_COST_PER_1M=0.40
OPENAI_OUTPUT_COST_PER_1M=1.60
CHAT_AUDIO_MAX_CHARS=8000
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_TEMPERATURE=0
INSIGHT_AI_MAX_SERIES_POINTS=18
INSIGHT_AI_MAX_PROMPT_CHARS=12000

# Performance Limits
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=60000
DB_STATEMENT_TIMEOUT_MS=60000
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
CHAT_MAX_ROWS=50000
CHAT_SAMPLE_ROWS=600
XLSX_WORKER_TIMEOUT_MS=45000
XLSX_SHEET_NAME_MAX_CHARS=120
ENABLE_STORAGE_USAGE_METRICS=false
SHEET_DATA_MAX_LIMIT=5000
SHEET_DATA_HARD_CAP=20000
MAX_UPLOAD_SHEETS=20
MAX_UPLOAD_ROWS_PER_SHEET=50000
MAX_UPLOAD_TOTAL_ROWS=100000
MAX_UPLOAD_COLUMNS=500
IMPORT_REQUIRE_APPROVAL=false
IMPORT_ASYNC_UPLOADS=false
AUDIT_LOG_MAX_METADATA_BYTES=8192
PROVIDER_FETCH_TIMEOUT_MS=15000
HEAVY_LIST_CACHE_TTL_MS=20000
HEAVY_LIST_CACHE_MAX=200
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_PRUNE_INTERVAL_MS=60000
LOGIN_RATE_LIMIT_MAX_BUCKETS=50000
AI_RATE_LIMIT_MAX=60
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_BUCKETS=50000
METRICS_MAX_SERIES=2000
CSRF_HEADER_NAME=x-csrf-token
CSRF_COOKIE_NAME=csrf_token
CSRF_BYPASS_BEARER=true
CSRF_STRICT_MODE=false
SHUTDOWN_TIMEOUT_MS=10000

# Frontend Configuration
VITE_API_URL=http://localhost:4000
