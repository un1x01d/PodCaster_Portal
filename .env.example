# Database Configuration
POSTGRES_USER=portal
POSTGRES_PASSWORD=choose_a_strong_password
POSTGRES_DB=portaldb

# Backend Configuration
DATABASE_URL=postgres://portal:choose_a_strong_password@db:5432/portaldb
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=portal
POSTGRES_PASSWORD=choose_a_strong_password
POSTGRES_DB=portaldb
JWT_SECRET=generate_a_long_random_string_at_least_32_characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=data-insights-portal
JWT_AUDIENCE=data-insights-portal-api
ALLOW_LEGACY_PLAINTEXT_PASSWORDS=false
SETTINGS_CRYPTO_KEY=generate_a_unique_random_key_for_setting_encryption_32_chars_min
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=25000
OPENAI_INPUT_COST_PER_1M=0.40
OPENAI_OUTPUT_COST_PER_1M=1.60
CHAT_AUDIO_MAX_CHARS=8000
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_TEMPERATURE=0
INSIGHT_AI_MAX_SERIES_POINTS=18
INSIGHT_AI_MAX_PROMPT_CHARS=12000

# Performance Limits
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=60000
DB_STATEMENT_TIMEOUT_MS=60000
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
# Customer database isolation. When enabled, each customer gets its own Postgres
# database in the same instance; keep tenant pools small to avoid exhausting Cloud SQL.
TENANT_DB_ISOLATION_ENABLED=true
TENANT_DB_PREFIX=tenant
TENANT_DB_POOL_MAX=3
TENANT_DB_POOL_IDLE_TIMEOUT_MS=30000
CHAT_MAX_ROWS=50000
CHAT_SAMPLE_ROWS=600
XLSX_WORKER_TIMEOUT_MS=45000
XLSX_SHEET_NAME_MAX_CHARS=120
XLSX_WORKER_DEFAULT_MEMORY_MB=512
XLSX_WORKER_MIN_MEMORY_MB=64
XLSX_WORKER_MAX_MEMORY_MB=4096
ENABLE_STORAGE_USAGE_METRICS=false
SHEET_DATA_MAX_LIMIT=5000
SHEET_DATA_HARD_CAP=20000
MAX_UPLOAD_SHEETS=20
MAX_UPLOAD_ROWS_PER_SHEET=50000
MAX_UPLOAD_TOTAL_ROWS=100000
MAX_UPLOAD_COLUMNS=500
IMPORT_REQUIRE_APPROVAL=false
# Durable async import queue (Postgres-backed, no external queue service required).
IMPORT_DB_QUEUE_ENABLED=true
# Retry cap for transient worker/import failures.
IMPORT_JOB_MAX_ATTEMPTS=3
# How long a worker lease stays valid before another instance can reclaim the job.
IMPORT_JOB_LEASE_MS=120000
# Queue polling cadence for new jobs.
IMPORT_JOB_POLL_MS=2000
# Jobs claimed per polling tick (raise cautiously to protect DB/CPU).
IMPORT_JOB_MAX_CLAIMS_PER_TICK=1
# Retention window for queued payload bytes in DB.
IMPORT_JOB_PAYLOAD_TTL_HOURS=24
AUDIT_LOG_MAX_METADATA_BYTES=8192
OAUTH_PUBLIC_RATE_LIMIT_MAX=40
OAUTH_PUBLIC_RATE_LIMIT_WINDOW_MS=300000
OAUTH_PUBLIC_RATE_LIMIT_MAX_BUCKETS=50000
OAUTH_EXCHANGE_RATE_LIMIT_MAX=20
OAUTH_EXCHANGE_RATE_LIMIT_WINDOW_MS=300000
OAUTH_EXCHANGE_RATE_LIMIT_MAX_BUCKETS=50000
PROVIDER_FETCH_TIMEOUT_MS=15000
PROVIDER_IMPORT_MAX_BYTES=104857600
HEAVY_LIST_CACHE_TTL_MS=20000
HEAVY_LIST_CACHE_MAX=200
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_PRUNE_INTERVAL_MS=60000
LOGIN_RATE_LIMIT_MAX_BUCKETS=50000
AI_RATE_LIMIT_MAX=60
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_BUCKETS=50000
INVITE_LOOKUP_RATE_LIMIT_MAX=40
INVITE_LOOKUP_RATE_LIMIT_WINDOW_MS=300000
INVITE_LOOKUP_RATE_LIMIT_MAX_BUCKETS=50000
INVITE_ACCEPT_RATE_LIMIT_MAX=15
INVITE_ACCEPT_RATE_LIMIT_WINDOW_MS=600000
INVITE_ACCEPT_RATE_LIMIT_MAX_BUCKETS=50000
INVITE_ISSUE_RATE_LIMIT_MAX=30
INVITE_ISSUE_RATE_LIMIT_WINDOW_MS=600000
INVITE_ISSUE_RATE_LIMIT_MAX_BUCKETS=50000
CUSTOMER_INVITE_TTL_HOURS=72
CUSTOMER_INVITE_RETENTION_DAYS=30
INVITATION_CLEANUP_INTERVAL_MS=3600000
CUSTOMER_INVITE_BASE_URL=
INVITE_EMAIL_LOGO_URL=
METRICS_MAX_SERIES=2000
CSRF_HEADER_NAME=x-csrf-token
CSRF_COOKIE_NAME=csrf_token
CSRF_BYPASS_BEARER=false
CSRF_STRICT_MODE=true
SHUTDOWN_TIMEOUT_MS=10000

# Frontend Configuration
VITE_API_URL=http://localhost:4000
