# Database Configuration
POSTGRES_USER=portal
POSTGRES_PASSWORD=choose_a_strong_password
POSTGRES_DB=portaldb

# Backend Configuration
DATABASE_URL=postgres://portal:choose_a_strong_password@db:5432/portaldb
JWT_SECRET=generate_a_long_random_string
JWT_EXPIRES_IN=8h
JWT_ISSUER=podcaster-portal
JWT_AUDIENCE=podcaster-portal-api
ALLOW_LEGACY_PLAINTEXT_PASSWORDS=false
SETTINGS_CRYPTO_KEY=generate_a_unique_random_key_for_setting_encryption

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=25000
CHAT_AUDIO_MAX_CHARS=8000

# Performance Limits
CHAT_MAX_ROWS=50000
CHAT_SAMPLE_ROWS=120
XLSX_WORKER_TIMEOUT_MS=45000
ENABLE_STORAGE_USAGE_METRICS=false

# Frontend Configuration
VITE_API_URL=http://localhost:4000
